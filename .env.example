# Supabase: Project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose this in the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# The public address of this site (no trailing slash). Used in emails and QR codes.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional public details. Each section stays hidden until its value is set.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_ACCREDITATION=
NEXT_PUBLIC_RECTOR_NAME=
NEXT_PUBLIC_REGISTRAR_NAME=
